# ==============================================================================
# ShadowVault Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit actual secrets or credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="ShadowVault"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication (Generate random 32+ char secret in production)
SECRET_KEY=change-this-insecure-key-to-a-cryptographically-secure-random-token-32char
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Super Admin Bootstrap (Initial setup only)
INITIAL_SUPERADMIN_EMAIL=admin@shadowvault.io
INITIAL_SUPERADMIN_PASSWORD=ShadowVault#SecOps2026!

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shadowvault_app
POSTGRES_PASSWORD=shadowvault_secure_password_replace
POSTGRES_DB=shadowvault
DATABASE_URL=postgresql+asyncpg://shadowvault_app:shadowvault_secure_password_replace@localhost:5432/shadowvault

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_graph_password_replace

# Redis & Celery Worker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI & Threat Intelligence Engine
AI_PROVIDER=local
AI_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend Public Environment Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="ShadowVault ITDR"
